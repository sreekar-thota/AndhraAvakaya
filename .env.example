# Andhra Avakaya - Environment Variables Template
# Copy this file to .env and configure your values

# -----------------------------------------------------------------------------
# Admin Authentication Credentials
# -----------------------------------------------------------------------------
ADMIN_USERNAME=uday
# Salted scrypt hash (format: salt:hash). Default corresponds to 'uday0309':
ADMIN_PASSWORD_HASH=64596425ea607dd0d22a30dbdf6478de:3c94ea66868b95cba487c2648b095f9635baaeb3ad09da76e7852370bf814772c6ba123526a668f7a64ff8c7a1a7c889a21ff77367155f83543113129f02336a
# Or specify plain password for local dev (will be hashed automatically in memory):
# ADMIN_PASSWORD=uday0309
SESSION_SECRET=c8f3e2b9a7104f6e85293d14ab529e847c130d7b29a174c82b95107e324efb18

# -----------------------------------------------------------------------------
# Supabase Persistent Inventory Database (Required for Vercel deployment)
# Get these from your Supabase Dashboard: Settings > API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Service role key: kept strictly SERVER-SIDE in Vercel environment variables
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Optional public anon key
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Local dev server port
PORT=3001
